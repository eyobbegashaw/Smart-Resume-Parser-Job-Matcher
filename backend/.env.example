# Copy this file to backend/.env before running `npm start`
# DO NOT put real passwords or API keys in this file — put them in backend/.env
# Server
PORT=5000
NODE_ENV=development

# Online MongoDB Atlas Connection String (required)
# Replace <db_username>, <db_password>, and <cluster-url> in backend/.env
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/resume-parser?retryWrites=true&w=majority

# JWT (set long random secrets in backend/.env)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_SECRET=change-this-to-another-long-random-secret
JWT_EXPIRE=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Google Gemini AI (optional; deterministic fallback parser is used when unset)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Email SMTP (optional; set Gmail App Password in SMTP_PASS inside backend/.env)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=
SMTP_FROM=your-email@gmail.com
# Frontend URL
FRONTEND_URL=http://localhost:5173

# Contact Email
CONTACT_EMAIL=contact@resumeparser.et
